# PaveLens AI · local configuration
#
# 1. Copy this file to `.env` in the same folder (the repository root):
#      Windows (PowerShell):  Copy-Item .env.example .env
#      macOS / Linux:         cp .env.example .env
#    `start.ps1` and `start.sh` do this for you on the first run.
# 2. Fill in the values you need and restart the API.
#
# `.env` is git-ignored: your keys never leave your machine. The API reads it on startup;
# real environment variables override it, and it overrides appsettings.json and user-secrets.
#
# With everything left as is, PaveLens runs in DEMO MODE: no keys, no cost, deterministic
# results that the interface labels "Demo mode".
#
# To use the real Meta models, META_API_KEY is the only value you need: the mode switches to Meta,
# segmentation uses SAM 3.1 on Meta with the same key, and the API picks the best models your key
# can use (newest Muse Wonder, else Muse Spark; newest SAM). It never picks "-contributor" models.

# ---------------------------------------------------------------------------
# Mode: Auto (default: Meta when META_API_KEY is set, else demo) | Simulation | Meta
# ---------------------------------------------------------------------------
PAVELENS_AI_PROVIDER=Auto

# ---------------------------------------------------------------------------
# Meta Muse Wonder: diagnosis, assistant, traffic plan and agent coordinator.
# OpenAI-compatible endpoint https://api.meta.ai/v1/. Get a key at https://dev.meta.ai
# ---------------------------------------------------------------------------
META_API_KEY=
# Optional: a fixed model name (e.g. muse-spark-1.3). Empty or "auto" picks the best available.
META_REASONING_MODEL=

# ---------------------------------------------------------------------------
# Segmentation service: Auto (default: Roboflow if ROBOFLOW_API_KEY is set, else Meta) | Roboflow | Meta | Sidecar
#   Roboflow  Meta SAM 3 on Roboflow's serverless API. Needs ROBOFLOW_API_KEY
#             (free key at https://app.roboflow.com → Settings → API Keys).
#   Meta      SAM 3.1 directly on Meta Model API. Uses META_API_KEY unless
#             META_SAM31_API_KEY is set. Needs Node.js and, once:
#               cd backend/tools/sam31 && npm ci
#   Sidecar   Your own service implementing POST /v1/segment (backend/docs/ai-contracts.md);
#             set Ai__Meta__Segmentation__BaseUrl below.
# ---------------------------------------------------------------------------
PAVELENS_SEGMENTATION_SERVICE=Auto
ROBOFLOW_API_KEY=
META_SAM31_API_KEY=

# ---------------------------------------------------------------------------
# Advanced: any configuration key, written with __ instead of :
# (see backend/src/PaveLens.Api/appsettings.json and backend/docs/ORCHESTRATION.md)
# ---------------------------------------------------------------------------
# Ai__Meta__Reasoning__TimeoutSeconds=120
# Ai__Meta__ReasoningEffort=low
# Ai__Meta__Segmentation__BaseUrl=http://localhost:8001/
# Orchestration__MaxToolCalls=16
# Database__Provider=Postgres
# ConnectionStrings__PaveLens=Host=localhost;Database=pavelens;Username=pavelens;Password=change-me
