  "en": {
    "summary": "[Simulation] Synthetic demo scene. Deep, high-severity pothole with standing water and a fine longitudinal crack beside it. The photo covers less than one sample unit, so the PCI is an upper bound.",
    "distresses": {
      "B1": {
        "diagnosis": "Deep pothole with vertical edges and recent standing water; the granular base is exposed in the centre.",
        "recommendedAction": "Immediate full-depth patch: the water speeds up erosion of the base."
      },
      "FL1": {
        "diagnosis": "Fine longitudinal crack running parallel to the pothole.",
        "recommendedAction": "Seal with asphalt emulsion during the same intervention."
      }
    },
    "steps": [
      {
        "title": "Mark off and sign the area",
        "instructions": "Close the right lane with cones 20 m before the pothole.",
        "tools": [
          "Cones",
          "Roadworks sign"
        ]
      },
      {
        "title": "Full-depth patch of B1",
        "instructions": "Remove the water and loose material, saw-cut a rectangle with a 15 cm margin and refill in compacted layers.",
        "tools": [
          "Diamond saw",
          "Jackhammer",
          "Plate compactor"
        ]
      },
      {
        "title": "Seal FL1",
        "instructions": "Clean the crack and seal it with asphalt emulsion.",
        "tools": [
          "Air compressor",
          "Asphalt sealant"
        ]
      }
    ]
  }
