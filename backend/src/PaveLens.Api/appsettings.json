{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaveLens": "Data Source=App_Data/pavelens.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": false
  },
  "Storage": {
    "LocalRootPath": "App_Data/images"
  },
  "Seed": {
    "Enabled": false
  },
  "Ai": {
    "Provider": "Auto",
    "Meta": {
      "SegmentationService": "Auto",
      "Segmentation": { "BaseUrl": "https://serverless.roboflow.com/", "Model": "sam3", "TimeoutSeconds": 60 },
      "SegmentationScoreThreshold": 0.5,
      "Reasoning": { "BaseUrl": "https://api.meta.ai/v1/", "Model": "auto", "TimeoutSeconds": 120 },
      "ReasoningEffort": "low",
      "JsonMode": true
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AiRequestsPerMinute": 20
  }
}
