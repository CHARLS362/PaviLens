  "en": {
    "summary": "[Simulation] Synthetic demo scene. A 25 m stretch with two potholes, an area of alligator cracking, longitudinal and transverse cracks and light rutting. Together they point to fatigue of the surface course sped up by freeze cycles: patch before the rainy season.",
    "distresses": {
      "B1": {
        "diagnosis": "Pothole with vertical edges and loose aggregate at the bottom; it sits in the right wheel path of the lane.",
        "recommendedAction": "Full-depth patch: rectangular cut, material removal, tack coat and hot mix compacted in layers."
      },
      "B2": {
        "diagnosis": "Pothole forming, with loss of surface course and ravelled edges.",
        "recommendedAction": "Shallow patch with a rectangular cut and hot mix."
      },
      "PC1": {
        "diagnosis": "Interconnected cracks in a mesh (alligator cracking) from fatigue; 10–20 cm cells without spalling.",
        "recommendedAction": "Full-depth patch of the cracked area; check drainage and base capacity."
      },
      "FL1": {
        "diagnosis": "Fine longitudinal crack next to the centre line, estimated under 1 cm wide.",
        "recommendedAction": "Blow clean with compressed air and seal with asphalt emulsion."
      },
      "FT1": {
        "diagnosis": "Full-width transverse crack, typical of thermal contraction from Altiplano freezes.",
        "recommendedAction": "Rout and seal with modified asphalt to withstand the thermal cycles."
      },
      "AH1": {
        "diagnosis": "Light longitudinal depression in the outer wheel path.",
        "recommendedAction": "Mill and replace the surface in the wheel path if it progresses; monitor at the next inspection."
      }
    },
    "steps": [
      {
        "title": "Sign and close one lane",
        "instructions": "Set up the detour according to the traffic simulation for segment H11 before starting the cuts.",
        "tools": [
          "Cones",
          "Detour signs",
          "STOP/SLOW paddles"
        ]
      },
      {
        "title": "Full-depth patch of B1",
        "instructions": "Cut a rectangle 15 cm beyond the visible edge, remove material down to sound base, apply a tack coat and refill with hot mix in 5 cm layers.",
        "tools": [
          "Diamond saw",
          "Jackhammer",
          "Plate compactor"
        ]
      },
